# API Settings
API_TITLE="智慧交通法規與判例檢索輔助系統"
API_VERSION="1.0.0"
API_DESCRIPTION="Traffic Law and Case Retrieval System"

# Database Settings
CHROMA_HOST="localhost"
CHROMA_PORT=8000
SQLITE_DB_PATH="data/kp_app_mapping.db"

# ChromaDB Collections
KNOWLEDGE_POINTS_COLLECTION="knowledge_points"
APPLICATIONS_COLLECTION="applications"
IMAGE_FEATURES_COLLECTION="image_features"

# Retrieval Settings
TOP_K_KP=10
TOP_K_CASES=20
RERANK_TOP_N=5

# LLM Settings
LLM_MODEL="gpt-4"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# OpenAI API Key
OPENAI_API_KEY="your-api-key-here"

# Embedding Settings
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# VLM Settings (Optional)
ENABLE_VLM=false
VLM_MODEL=""

# Performance Settings
MAX_QUERY_TIMEOUT=30
ENABLE_CACHE=true
CACHE_TTL=3600

# Alignment Settings
MIN_ALIGNMENT_CONFIDENCE=0.5
